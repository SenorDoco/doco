{
  "$schema": "https://claude.com/schemas/settings.json",
  "permissions": {
    "allow": [
      "Bash(doco:*)",
      "Bash(node .agents/doco-agent-client.mjs:*)",
      "WebFetch(domain:pepe.com)",
      "mcp__doco__doco_search",
      "mcp__github__pull_request_read",
      "mcp__7087442d-26eb-4e3d-8452-02da344449d7__list_deployments",
      "mcp__7087442d-26eb-4e3d-8452-02da344449d7__get_deployment"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node packages/web/app/hook/doco-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node packages/web/app/hook/doco-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
