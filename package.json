{
  "name": "@doco/monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Alignment framework and runtime checking system. See README.md.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doco": "pnpm --filter doco-cli doco",
    "deploy": "pnpm dlx vercel pull --yes --environment=production && pnpm dlx vercel build --prod && pnpm dlx vercel deploy --prebuilt --prod"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {}
}
