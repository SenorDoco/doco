{
  "name": "@doco/monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Alignment framework and runtime checking system. See README.md.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @doco/web build",
    "build:packages": "pnpm --workspace-concurrency=1 --filter='./packages/*' --filter='!@doco/web' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint",
    "deploy": "pnpm dlx vercel pull --yes --environment=production && pnpm dlx vercel build --prod && pnpm dlx vercel deploy --prebuilt --prod",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {}
}
