{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://doco.dev/schemas/v0.2/doco.schema.json",
  "title": "Doco entity schema (v0.2)",
  "description": "Validates the structured fields of every entity in a Doco. Entities are stored as YAML (.yaml) or Markdown-with-frontmatter (.md); the YAML / frontmatter is the part this schema covers. See SCHEMA.md §3-§4 for prose definitions and worked examples.\n\nv0.2: hosted-multi-tenant types (principal, organization) removed and actor fields relaxed to free-form strings. Per ADR-087 (local-solo collapse).",
  "definitions": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "id": {
      "type": "string",
      "description": "'<node_type>_<ULID>' — entity ID prefixed by its node_type (D-004, D-005).",
      "pattern": "^(intent|idea|rule|decision|action|reasoning|evaluation|reference|scope|doco)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "doco_id": {
      "type": "string",
      "pattern": "^doco_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^scope_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "actor_string": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form actor identifier (e.g., 'torrenegra', 'claude-opus-4-7', 'human:alice'). Per ADR-087 (local-solo collapse): no Principal type, no auth, no enforced format. Conventions encouraged: human GitHub-login-style for humans, '<provider>-<model>' for agents."
    },
    "namespaced_id": {
      "type": "string",
      "description": "Within-Doco bare ID, or cross-Doco '<namespace>:<id>' (D-029).",
      "pattern": "^([a-z][a-z0-9_-]*:)?(intent|idea|rule|decision|action|reasoning|evaluation|reference|scope|doco)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "datetime": { "type": "string", "format": "date-time" },
    "lifecycle": {
      "type": "string",
      "description": "Canonical state across stateful entities (D-007).",
      "enum": ["proposed", "active", "succeeded", "failed", "superseded", "abandoned"]
    },
    "common_fields": {
      "type": "object",
      "description": "Fields that appear on every entity (SCHEMA.md §3 / D-006).",
      "required": ["id", "doco_id", "node_type", "schema_version", "summary", "created_at", "created_by"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "doco_id": { "$ref": "#/definitions/doco_id" },
        "node_type": { "type": "string" },
        "schema_version": { "type": "string" },
        "summary": { "type": "string", "maxLength": 240 },
        "created_at": { "$ref": "#/definitions/datetime" },
        "created_by": { "$ref": "#/definitions/actor_string" },
        "updated_at": { "$ref": "#/definitions/datetime" },
        "updated_by": { "$ref": "#/definitions/actor_string" },
        "revision": { "type": "integer", "minimum": 1 },
        "lifecycle": { "$ref": "#/definitions/lifecycle" },
        "status": { "type": "string" },
        "scopes": { "type": "array", "items": { "$ref": "#/definitions/scope_id" } },
        "born_from": { "$ref": "#/definitions/id" },
        "follows": {
          "type": "array",
          "description": "Ordering / dependency: this entity comes after the listed entities. BPMN-style sequencing for any node type. Lint forbids cycles. Per ADR-077.",
          "items": { "$ref": "#/definitions/id" }
        }
      }
    },
    "scope_selector": {
      "type": "object",
      "description": "Predicate over entities (SCHEMA.md §5). Free-form for v0.1; tighter validation deferred until usage shows the right shape.",
      "additionalProperties": true
    },
    "doco_entity": {
      "type": "object",
      "required": ["id", "node_type", "schema_version", "slug", "display_name"],
      "properties": {
        "id": { "$ref": "#/definitions/doco_id" },
        "node_type": { "const": "doco" },
        "schema_version": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)?$", "description": "Slug. Single-segment for local-solo (v0.2); historical '<owner>/<slug>' two-segment form still accepted." },
        "display_name": { "type": "string" },
        "visibility": { "type": "string", "enum": ["private", "public"] },
        "default_branch": { "type": "string" },
        "description": { "type": "string" },
        "summary": { "type": "string", "maxLength": 240 },
        "created_at": { "$ref": "#/definitions/datetime" },
        "created_by": { "$ref": "#/definitions/actor_string" },
        "updated_at": { "$ref": "#/definitions/datetime" },
        "updated_by": { "$ref": "#/definitions/actor_string" },
        "revision": { "type": "integer", "minimum": 1 },
        "lifecycle": { "$ref": "#/definitions/lifecycle" },
        "status": { "type": "string" },
        "scopes": { "type": "array", "items": { "$ref": "#/definitions/scope_id" } },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["doco", "ref", "as"],
            "properties": {
              "doco": { "type": "string" },
              "ref": { "type": "string" },
              "as": { "type": "string" },
              "include": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "intent_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "node_type": { "const": "intent" },
            "slug": { "type": "string" },
            "title": { "type": "string" },
            "parent_intent_id": {
              "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }]
            },
            "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] },
            "non_goals": { "type": "array", "items": { "type": "string" } },
            "acceptance": { "type": "array", "items": { "type": "string" } },
            "stakeholders": { "type": "array", "items": { "$ref": "#/definitions/actor_string" } },
            "applies_to": { "$ref": "#/definitions/scope_selector" }
          }
        }
      ]
    },
    "rule_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["modality", "phase", "applies_to"],
          "properties": {
            "node_type": { "const": "rule" },
            "slug": { "type": "string" },
            "modality": { "type": "string", "enum": ["must", "must_not", "should", "should_not"] },
            "severity": { "type": "string", "enum": ["blocker", "warning", "info"] },
            "phase": { "type": "string", "enum": ["declared", "pre", "post", "invariant"] },
            "applies_to": { "$ref": "#/definitions/scope_selector" },
            "predicate": { "type": "string" },
            "expected": {},
            "on_violation": { "type": "string", "enum": ["block", "warn", "log"] }
          }
        }
      ]
    },
    "decision_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["question", "chosen", "decided_by", "decided_at"],
          "properties": {
            "node_type": { "const": "decision" },
            "slug": { "type": "string" },
            "number": { "type": "string", "description": "Optional ADR-style number, set when scope_adr is applied (D-022)." },
            "intent_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "question": { "type": "string" },
            "chosen": { "type": "string" },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "rejected_because": { "type": "string" }
                }
              }
            },
            "rules_consulted": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "decided_by": { "$ref": "#/definitions/actor_string" },
            "decided_at": { "$ref": "#/definitions/datetime" },
            "superseded_by": { "$ref": "#/definitions/id" }
          }
        }
      ]
    },
    "action_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["actor_id", "verb"],
          "properties": {
            "node_type": { "const": "action" },
            "actor_id": { "$ref": "#/definitions/actor_string" },
            "verb": { "type": "string" },
            "target": { "$ref": "#/definitions/id" },
            "intent_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "decision_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "inputs": { "type": "object", "additionalProperties": true },
            "outputs": { "type": "object", "additionalProperties": true },
            "started_at": { "$ref": "#/definitions/datetime" },
            "ended_at": { "$ref": "#/definitions/datetime" },
            "attestation": { "type": "string" }
          }
        }
      ]
    },
    "reasoning_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["author_id", "premises", "inference"],
          "properties": {
            "node_type": { "const": "reasoning" },
            "author_id": { "$ref": "#/definitions/actor_string" },
            "premises": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["node_type", "ref", "as"],
                "properties": {
                  "node_type": { "type": "string" },
                  "ref": { "$ref": "#/definitions/id" },
                  "as": { "type": "string" }
                }
              }
            },
            "inference": { "type": "string" },
            "conclusion_ref": { "$ref": "#/definitions/id" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "uncertainty": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "evaluation_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["rule_id", "result", "ran_at", "ran_by"],
          "properties": {
            "node_type": { "const": "evaluation" },
            "rule_id": { "$ref": "#/definitions/id" },
            "target_id": { "type": "string" },
            "result": { "type": "string", "enum": ["pass", "fail", "error"] },
            "evidence": { "type": "object", "additionalProperties": true },
            "ran_at": { "$ref": "#/definitions/datetime" },
            "ran_by": { "$ref": "#/definitions/actor_string" },
            "duration_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "reference_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["ref_type", "locator"],
          "properties": {
            "node_type": { "const": "reference" },
            "ref_type": { "type": "string", "enum": ["file", "url", "ticket", "commit", "document", "other"] },
            "locator": { "type": "string" },
            "content_hash": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "scope_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "node_type": { "const": "scope" },
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "description": "Scope name. Flat token: lowercase + digits + underscores + hyphens. Hierarchy via parent edges in the `scopes` field, not via slashes in the name. Per ADR-081." },
            "description": { "type": "string" },
            "purpose": { "type": "string", "description": "Why this scope exists; what kind of nodes belong inside it. Per ADR-082." },
            "guidelines": { "type": "string", "description": "Markdown guidance on how nodes in this scope should be authored. E.g., a `user-flows` scope might say 'use BPMN-flavor: chain Actions with `follows`, branch via Decisions.' Exposed to agents on Doco onboarding. Per ADR-082." }
          }
        }
      ]
    },
    "idea_entity": {
      "allOf": [
        { "$ref": "#/definitions/common_fields" },
        {
          "type": "object",
          "description": "Speculative thought before it crystallizes into an Intent / Decision / Action. Per ADR-074. Optional fields only — `summary` carries the gist; `body` carries the elaboration.",
          "properties": {
            "node_type": { "const": "idea" },
            "proposer_id": {
              "$ref": "#/definitions/actor_string",
              "description": "Actor string who originated the idea. Often equals created_by; differs when an idea is recorded by someone other than the proposer."
            },
            "body": { "type": "string", "description": "Free-form description; treat as the spec for the idea." },
            "promoted_to": {
              "$ref": "#/definitions/id",
              "description": "If the idea has been promoted, the resulting Intent / Decision / Action id. Pair with `lifecycle: succeeded`."
            },
            "rejection_reason": { "type": "string", "description": "If `lifecycle: abandoned`, the reason." }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/doco_entity" },
    { "$ref": "#/definitions/intent_entity" },
    { "$ref": "#/definitions/idea_entity" },
    { "$ref": "#/definitions/rule_entity" },
    { "$ref": "#/definitions/decision_entity" },
    { "$ref": "#/definitions/action_entity" },
    { "$ref": "#/definitions/reasoning_entity" },
    { "$ref": "#/definitions/evaluation_entity" },
    { "$ref": "#/definitions/reference_entity" },
    { "$ref": "#/definitions/scope_entity" }
  ]
}
