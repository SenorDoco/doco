# Doco agent-bootstrap env. Copy to .env and fill in. .env is gitignored
# by `doco init`; never commit secrets.
#
# Easiest path: don't fill these in by hand — run
#   doco login --host <DOCO_HOST> --create <slug>
# from the repo root. The CLI opens a browser tab where the project
# owner approves the session and (optionally) creates a new Doco, then
# the CLI writes all three vars below to ./.env automatically. See the
# "If DOCO_HOST, DOCO_TOKEN, or DOCO_SLUG aren't set" section of
# AGENTS.md for the full flow.
#
# Read by .claude/bootstrap-fetch.sh (SessionStart hook) and
# .claude/user-prompt-fetch.sh (UserPromptSubmit hook).

# Your Doco host's base URL. Local dev: http://localhost:5173.
DOCO_HOST=http://localhost:5173

# Your Doco slug — <owner>/<doco>. Tells the per-prompt hook which Doco to
# query for relevant nodes (e.g. acme/payments, torrenegra/doco).
DOCO_SLUG=

# Bearer token for write capture (POST/PATCH on /api/*.json) + per-Doco
# context on the bootstrap response. Minted by `doco login` (recommended)
# or via $DOCO_HOST/<owner>/<doco>/settings → "Issue token". Treat as
# secret.
DOCO_TOKEN=
