{
  "name": "@evalo/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Evalo CLI — init, show, validate, query, check, lint.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "bin": {
    "evalo": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evalo": "tsx src/index.ts"
  },
  "dependencies": {
    "@evalo/api": "workspace:*",
    "@evalo/core": "workspace:*",
    "@evalo/discovery": "workspace:*",
    "@evalo/host": "workspace:*",
    "@evalo/index": "workspace:*",
    "@evalo/lints": "workspace:*",
    "@evalo/runtime": "workspace:*",
    "@evalo/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "citty": "^0.1.6",
    "kleur": "^4.1.5"
  }
}
