{
  "name": "@doco/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Doco CLI — init, show, validate, query, check, lint.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "bin": {
    "doco": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doco": "tsx src/index.ts"
  },
  "dependencies": {
    "@doco/api": "workspace:*",
    "@doco/core": "workspace:*",
    "@doco/discovery": "workspace:*",
    "@doco/index": "workspace:*",
    "@doco/lints": "workspace:*",
    "@doco/runtime": "workspace:*",
    "@doco/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "citty": "^0.1.6",
    "kleur": "^4.1.5"
  }
}
