{
  "name": "doco-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Doco CLI — init, show, validate, capture, lint, query.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "bin": {
    "doco": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "doco": "tsx src/index.ts"
  },
  "dependencies": {
    "@doco/db": "workspace:*",
    "@doco/host": "workspace:*",
    "@doco/index": "workspace:*",
    "@doco/lints": "workspace:*",
    "@doco/shared": "workspace:*",
    "citty": "^0.1.6",
    "kleur": "^4.1.5",
    "yaml": "^2.6.1"
  }
}
