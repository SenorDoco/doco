{
  "name": "doco-cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Doco CLI — OAuth login and agent bootstrap installation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torrenegra/doco.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/torrenegra/doco#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "bin": {
    "doco": "./dist/index.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsx build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "doco": "tsx src/index.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
