{
  "name": "@evalo/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Source-of-truth layer: read, write, and validate Evalo entity files.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
