{
  "name": "@doco/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Postgres adapter for Doco source-of-truth storage.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "src/schema.sql"],
  "scripts": {
    "build": "node scripts/embed-schema.mjs && tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "typecheck": "node scripts/embed-schema.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/embed-schema.mjs && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@doco/shared": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
