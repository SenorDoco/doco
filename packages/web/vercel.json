{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && rm -rf node_modules packages/*/node_modules && pnpm install --frozen-lockfile --reporter=append-only",
  "crons": [
    {
      "path": "/admin/agent-health-cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/github/backfill-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/slack/mirror-sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/notion/mirror-sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/admin/purge-deleted-docos",
      "schedule": "0 3 * * *"
    }
  ]
}
