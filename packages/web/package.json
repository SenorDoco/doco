{
  "name": "@doco/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Doco web UI — Remix v7 (React Router 7) + Tailwind v4 + shadcn-style components.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "prebuild": "cd ../.. && pnpm --workspace-concurrency=1 --filter='./packages/*' --filter='!@doco/web' build",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit",
    "test": "echo 'web tests run via Chrome E2E'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@dagrejs/dagre": "^3.0.0",
    "@doco/db": "workspace:*",
    "@doco/host": "workspace:*",
    "@doco/index": "workspace:*",
    "@doco/shared": "workspace:*",
    "@react-router/node": "7.15.0",
    "@react-router/serve": "7.15.0",
    "@vercel/functions": "^3.5.1",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.17",
    "lucide-react": "^0.469.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.15.0",
    "tailwind-merge": "^2.5.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.0.0-beta.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vercel/react-router": "^1.3.0",
    "tailwindcss": "^4.0.0-beta.7",
    "vite": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
