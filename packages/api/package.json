{
  "name": "@doco/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Doco shared agent-facing library: canonical agent instructions, LLM helpers, token store, and invitation/agent creation. Imported by @doco/web — no standalone server.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests in @doco/api' && true",
    "test:watch": "echo 'no tests in @doco/api' && true"
  },
  "dependencies": {
    "@doco/host": "workspace:*",
    "@doco/shared": "workspace:*",
    "yaml": "^2.6.1"
  }
}
