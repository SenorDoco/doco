# Hoist installed packages into a flat node_modules layout so the
# Vercel deploy's serverless function trace can resolve pnpm-symlinked
# transitive paths (e.g. react-router/dist/development/index.mjs through
# packages/web/node_modules/react-router). Without this, Vercel deploys
# 500 with ERR_MODULE_NOT_FOUND on files that exist in the trace at the
# .pnpm location but not via the symlink the runtime tries to follow.
node-linker=hoisted
