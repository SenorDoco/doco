# The Doco hook's token reads the workspace as whoever made it: never committed.
# .doco/workspace, the project's workspace, is.
.doco/*
!.doco/workspace

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo
.turbo/
coverage/

# Remix / React Router framework outputs
build/
.react-router/

# OS / editor
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Env
.env
.env.local
.env.*.local

# Scratch
/tmp/
.vercel
/.scratch/

# Background-agent git worktrees (isolation: worktree) live here; never commit them.
.claude/worktrees/
