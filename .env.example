# Doco — local-dev environment variables.
# Copy to .env (gitignored) and fill in the values you need.

# GitHub OAuth (ADR-095) — required to create new accounts on this host.
# Register a GitHub OAuth App at https://github.com/settings/developers:
#   Application name:           Doco (local dev)
#   Homepage URL:               http://127.0.0.1:5173
#   Authorization callback URL: http://127.0.0.1:5173/auth/github/callback
# Then paste the credentials below.
DOCO_GITHUB_CLIENT_ID=
DOCO_GITHUB_CLIENT_SECRET=

# Optional — override the callback URL the OAuth helper uses. Defaults to
# `<request protocol>://<request host>/auth/github/callback`, which is right
# for localhost and for doco.dev. Set this only if you're tunneling.
# DOCO_GITHUB_REDIRECT_URI=https://your-domain.example.com/auth/github/callback

# Optional — HMAC key for signing the OAuth state cookie. Generate a strong
# value for production; leaving unset uses a dev default that's safe only
# locally.
# DOCO_GITHUB_STATE_KEY=

# Optional — DOCO_LOCALHOST_PICKER=1 enables the legacy username-picker on
# /sign-in for fast local-dev identity switching. Off by default; never
# enable in production (security hole — anyone could pick any user).
# DOCO_LOCALHOST_PICKER=1

# Optional — host root override. Defaults to walking upward from cwd for a
# folder containing host.yaml.
# DOCO_ROOT=/Users/me/Doco

# Optional — OpenAI key for /api/suggest-scopes (ADR-085). Not required.
# OPENAI_API_KEY=
