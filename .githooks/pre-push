#!/bin/sh
# Pre-push gate — the fast, high-signal half of the CI contract, run before code
# leaves your machine. It builds, typechecks, and lints (the cheap checks that
# catch most red work in ~1 min) but deliberately SKIPS the test suite,
# which CI (.github/workflows/ci.yml) re-runs and enforces as the authoritative
# required gate. Running the full `pnpm verify` here taxed every push with the
# same pipeline CI runs anyway; this keeps the local tripwire without the
# tax. Agent-neutral: fires for any tool or human that pushes via git (Claude,
# Cursor, Codex, a human shell, …). Auto-installed by the "prepare" script:
# `pnpm install` points core.hooksPath here.
#
# Bypass in a genuine pinch with:  git push --no-verify
# (CI still runs the full suite server-side, so a local bypass only delays the
# failure — and commits made via the GitHub API skip this hook entirely; CI is
# the net.)
echo "→ pre-push: build · typecheck · lint (tests run in CI; bypass with --no-verify)…"
pnpm run build && pnpm run typecheck && pnpm run lint
